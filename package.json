{
    "name": "kitchntabs-python-service",
    "version": "1.0.0",
    "description": "KitchnTabs Python Service - WebSocket, Print, and TTS Services",
    "author": "Francisco Aranda <farandal@gmail.com>",
    "license": "MIT",
    "private": true,
    "scripts": {
      "dev": "python3.9 ./src/kt_service.py 'USER_TOKEN' 'private-tenant.1.system' ./config.dev.mac.yaml log.txt",
      "dev-win": "py ./src/kt_service.py 'USER_TOKEN' 'private-tenant.1.system' ./config.dev.yaml log.txt",
      "build": "node build-service.js",
      "build:all": "node build-service.js --service=all",
      "build:kt": "node build-service.js --service=kt_service",
      "build:print": "node build-service.js --service=print_service",
      "build:tts": "node build-service.js --service=tts_service",
      "build:ngrok": "node build-service.js --custom-mode=kitchntabs.ngrok --service=all",
      "build:prod": "node build-service.js --custom-mode=kitchntabs.prod --service=all",
      "build:dev": "node build-service.js --custom-mode=dev --service=all",
      "build-win": "build.win.bat",
      "copy-dll-win": "copy-python-dll.bat",
      "build:docker": "node build-docker.js",
      "build:docker:all": "node build-docker.js --all",
      "build:docker:x64": "node build-docker.js --arch=x64",
      "build:docker:arm64": "node build-docker.js --arch=arm64",
      "build:docker:armv7l": "node build-docker.js --arch=armv7l",
      "build:docker:ngrok": "node build-docker.js --all --config=ngrok",
      "build:docker:prod": "node build-docker.js --all --config=prod",
      "build:docker:armv7l:ngrok": "node build-docker.js --arch=armv7l --config=ngrok",
      "build:docker:armv7l:prod": "node build-docker.js --arch=armv7l --config=prod",
      "build:docker:arm64:ngrok": "node build-docker.js --arch=arm64 --config=ngrok",
      "build:docker:arm64:prod": "node build-docker.js --arch=arm64 --config=prod",
      "build:docker:debian": "node build-docker.js --arch=armv7l --arch=arm64 --config=prod"
    },
    "dependencies": {}
}