    "license": "MIT",
    "private": true,
    "scripts": {
      "dev": "python3.9 ./src/ws_service.py 'USER_TOKEN' ./config.dev.yaml",
      "build": "pyinstaller ./src/ws_service.py --onefile --distpath ./service --add-data ./config.prod.yaml:. --add-data pw_env/lib/python3.9/site-packages/escpos/*.json:escpos --collect-data escpos --noconfirm"
    },
    "info": {
        "USER_TOKEN": "A valid dash user token"
    },
    "depenencies" : {
        
    }
}