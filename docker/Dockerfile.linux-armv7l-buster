# Dockerfile for building kt_service, print_service, tts_service for Linux ARMv7l (Raspberry Pi 3/4, 32-bit)
# Compatible with Raspberry Pi OS Buster (GLIBC 2.28)
# Uses Python 3.9 on Buster base to get modern Python while keeping GLIBC 2.28 compatibility
# Uses Debian archive since Buster reached EOL in June 2024

FROM --platform=linux/arm/v7 arm32v7/python:3.9-slim-buster

# Update apt sources to use the archive (Buster is EOL)
RUN sed -i 's/deb.debian.org/archive.debian.org/g' /etc/apt/sources.list && \
    sed -i 's/security.debian.org/archive.debian.org/g' /etc/apt/sources.list && \
    sed -i '/stretch-updates/d' /etc/apt/sources.list && \
    sed -i '/buster-updates/d' /etc/apt/sources.list

# Install system dependencies with retry logic for network issues
RUN apt-get update && \
    for i in 1 2 3; do \
        apt-get install -y --no-install-recommends \
            build-essential \
            gfortran \
            ffmpeg \
            libusb-1.0-0-dev \
            libasound2-dev \
            portaudio19-dev \
            libsndfile1-dev \
            libffi-dev \
            libssl-dev \
            libatlas-base-dev \
            libopenblas-dev \
        && break || (echo "Retry $i..." && sleep 5 && apt-get update); \
    done && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Configure pip to PRIORITIZE piwheels (pre-compiled ARM wheels for Buster)
# CRITICAL: piwheels must be primary to get GLIBC 2.28 compatible binaries
RUN pip install --upgrade pip && \
    echo "[global]" > /etc/pip.conf && \
    echo "index-url = https://www.piwheels.org/simple" >> /etc/pip.conf && \
    echo "extra-index-url = https://pypi.org/simple" >> /etc/pip.conf && \
    echo "" >> /etc/pip.conf && \
    echo "[install]" >> /etc/pip.conf && \
    echo "prefer-binary = true" >> /etc/pip.conf

# Copy ARMv7l-specific requirements for Buster with Python 3.9
COPY requirements-armv7l-buster.txt ./requirements.txt

# Install Python dependencies - piwheels first for GLIBC 2.28 compatibility
# Use --only-binary for packages that MUST come from piwheels to avoid PyPI wheels
# that require GLIBC 2.33+
# NOTE: Check https://www.piwheels.org/project/<package>/ for available versions
# Available scipy versions with piwheels wheels: 1.5.0-1.8.1, 1.11.3+
RUN pip install --no-cache-dir wheel && \
    echo "=== Installing numpy from piwheels ===" && \
    pip install --no-cache-dir --only-binary=:all: numpy==1.24.4 || \
    pip install --no-cache-dir numpy==1.24.4 && \
    echo "=== Installing scipy from piwheels (1.7.3 has armv7l wheel) ===" && \
    pip install --no-cache-dir --only-binary=:all: scipy==1.7.3 || \
    pip install --no-cache-dir scipy==1.7.3 && \
    echo "=== Installing Pillow from piwheels ===" && \
    pip install --no-cache-dir --only-binary=:all: Pillow==10.0.1 || \
    pip install --no-cache-dir Pillow==10.0.1 && \
    echo "=== Installing remaining requirements ===" && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir pyinstaller==5.13.2 && \
    echo "=== Verifying installed packages ===" && \
    pip list

# Copy source code
COPY src/ ./src/
COPY config*.yaml ./

# Build arguments
ARG CONFIG_FILE=config.kitchntabs.prod.yaml

# Copy the appropriate config file
RUN cp ${CONFIG_FILE} config.yaml

# Get escpos path and find all data files (capabilities JSON, etc.)
# Note: python-escpos package structure varies by version
RUN ESCPOS_PATH=$(python -c "import escpos; import os; print(os.path.dirname(escpos.__file__))") && \
    echo "ESCPOS_PATH=$ESCPOS_PATH" > /tmp/escpos_path && \
    echo "Contents of escpos package:" && \
    find $ESCPOS_PATH -type f \( -name "*.json" -o -name "*.yaml" -o -name "*.yml" \) | head -20

# Build all 3 services with PyInstaller
# 1. kt_service (main WebSocket service)
# The capabilities.json is directly in the escpos folder (not a subfolder)
RUN . /tmp/escpos_path && \
    python -m PyInstaller ./src/kt_service.py \
    --onefile \
    --distpath ./dist \
    --add-data "config.yaml:." \
    --add-data "$ESCPOS_PATH/capabilities.json:escpos/" \
    --hidden-import escpos.printer \
    --hidden-import escpos.escpos \
    --hidden-import escpos.capabilities \
    --noconfirm \
    --clean

# 2. print_service (thermal printing service)
RUN . /tmp/escpos_path && \
    python -m PyInstaller ./src/print_service.py \
    --onefile \
    --distpath ./dist \
    --add-data "config.yaml:." \
    --add-data "$ESCPOS_PATH/capabilities.json:escpos/" \
    --hidden-import escpos.printer \
    --hidden-import escpos.escpos \
    --hidden-import escpos.capabilities \
    --noconfirm \
    --clean

# 3. tts_service (text-to-speech service)
RUN python -m PyInstaller ./src/tts_service.py \
    --onefile \
    --distpath ./dist \
    --exclude-module tkinter \
    --exclude-module _tkinter \
    --noconfirm \
    --clean

# NOTE: kt_status_tray (system tray UI) is intentionally NOT built for Buster.
# It requires PyQt6/Qt6, which has no working wheels for GLIBC 2.28 - attempting
# to install it here would either fail the whole build or need a lengthy source
# compile. Buster targets legacy Pi OS installs and runs kt_service headless;
# see requirements-armv7l.txt (Bullseye) for the supported tray build.

# Output directory - copy the 3 core services (no tray on this legacy target)
RUN mkdir -p /output && \
    cp ./dist/kt_service /output/kt_service && \
    cp ./dist/print_service /output/print_service && \
    cp ./dist/tts_service /output/tts_service

CMD ["cp", "-r", "/output/.", "/host-output/"]
