# Dockerfile for building kt_service, print_service, tts_service for Linux ARM64 (Raspberry Pi 3/4/5, 64-bit)
# Compatible with Raspberry Pi OS Bookworm (Debian 12) - GLIBC 2.36+
FROM --platform=linux/arm64 python:3.11-slim-bookworm

# Install system dependencies with retry logic for network issues
# Added ffmpeg for pydub audio conversion (mp3 to wav)
RUN apt-get update && \
    for i in 1 2 3; do \
        apt-get install -y --no-install-recommends \
            build-essential \
            ffmpeg \
            libusb-1.0-0-dev \
            libasound2-dev \
            portaudio19-dev \
            libsndfile1-dev \
            libffi-dev \
            libssl-dev \
            libopenblas-dev \
        && break || (echo "Retry $i..." && sleep 5 && apt-get update); \
    done && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy ARM64-specific requirements first for better caching
COPY requirements-arm64.txt ./requirements.txt

# Install Python dependencies
# ARM64 on Bookworm has excellent wheel support
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir pyinstaller==6.3.0

# Copy source code
COPY src/ ./src/
COPY config*.yaml ./

# Build arguments
ARG CONFIG_FILE=config.kitchntabs.prod.yaml

# Copy the appropriate config file
RUN cp ${CONFIG_FILE} config.yaml

# Get escpos path and prepare capabilities structure
# python-escpos 3.1 has capabilities.json at root level, but code expects it at escpos/capabilities/
RUN ESCPOS_PATH=$(python -c "import escpos; import os; print(os.path.dirname(escpos.__file__))") && \
    echo "ESCPOS_PATH=$ESCPOS_PATH" > /tmp/escpos_path && \
    echo "Contents of escpos package:" && \
    find $ESCPOS_PATH -type f \( -name "*.json" -o -name "*.yaml" -o -name "*.yml" \) && \
    echo "---" && \
    # Create capabilities folder structure for PyInstaller bundling
    mkdir -p /tmp/escpos_data/capabilities && \
    cp $ESCPOS_PATH/capabilities.json /tmp/escpos_data/capabilities/ && \
    echo "Created capabilities folder with capabilities.json"

# Build all 3 services with PyInstaller
# 1. kt_service (main WebSocket service)
# Note: Bundle capabilities.json to escpos/capabilities/ to match code expectations
RUN ESCPOS_PATH=$(cat /tmp/escpos_path | cut -d= -f2) && \
    python -m PyInstaller ./src/kt_service.py \
    --onefile \
    --distpath ./dist \
    --add-data "config.yaml:." \
    --add-data "/tmp/escpos_data/capabilities:escpos/capabilities" \
    --add-data "$ESCPOS_PATH:escpos" \
    --collect-submodules escpos \
    --hidden-import escpos.printer \
    --hidden-import escpos.escpos \
    --hidden-import escpos.capabilities \
    --hidden-import jaraco \
    --hidden-import jaraco.text \
    --hidden-import jaraco.functools \
    --hidden-import jaraco.context \
    --hidden-import pkg_resources \
    --hidden-import importlib_metadata \
    --collect-all jaraco \
    --collect-all pkg_resources \
    --noconfirm \
    --clean

# 2. print_service (thermal printing service)
RUN ESCPOS_PATH=$(cat /tmp/escpos_path | cut -d= -f2) && \
    python -m PyInstaller ./src/print_service.py \
    --onefile \
    --distpath ./dist \
    --add-data "config.yaml:." \
    --add-data "/tmp/escpos_data/capabilities:escpos/capabilities" \
    --add-data "$ESCPOS_PATH:escpos" \
    --collect-submodules escpos \
    --hidden-import escpos.printer \
    --hidden-import escpos.escpos \
    --hidden-import escpos.capabilities \
    --hidden-import jaraco \
    --hidden-import jaraco.text \
    --hidden-import jaraco.functools \
    --hidden-import jaraco.context \
    --hidden-import pkg_resources \
    --hidden-import importlib_metadata \
    --collect-all jaraco \
    --collect-all pkg_resources \
    --noconfirm \
    --clean

# 3. tts_service (text-to-speech service)
RUN python -m PyInstaller ./src/tts_service.py \
    --onefile \
    --distpath ./dist \
    --hidden-import jaraco \
    --hidden-import jaraco.text \
    --hidden-import jaraco.functools \
    --hidden-import jaraco.context \
    --hidden-import pkg_resources \
    --hidden-import importlib_metadata \
    --collect-all jaraco \
    --collect-all pkg_resources \
    --noconfirm \
    --clean

# Output directory - copy all 3 services
RUN mkdir -p /output && \
    cp ./dist/kt_service /output/kt_service && \
    cp ./dist/print_service /output/print_service && \
    cp ./dist/tts_service /output/tts_service

CMD ["cp", "-r", "/output/.", "/host-output/"]
